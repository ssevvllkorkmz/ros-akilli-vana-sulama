Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
    - Class: rviz/MarkerArray
      Name: Parseller
      Enabled: true
      Marker Topic: /irrigation/markers
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7
      Focal Point: {X: 1, Y: 1, Z: 0}
      Pitch: 0.9
      Yaw: 0.8
