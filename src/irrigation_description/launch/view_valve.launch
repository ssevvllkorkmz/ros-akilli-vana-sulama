<!-- Hafta 1 kabul testi: vanayı RViz'de joint slider ile 0-90° döndür -->
<launch>
  <param name="robot_description"
         command="$(find xacro)/xacro $(find irrigation_description)/urdf/single_valve.urdf.xacro"/>
  <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find irrigation_description)/rviz/valve.rviz"/>
</launch>
